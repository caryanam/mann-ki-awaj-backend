# Copy to application.properties only for local development. Supply secrets through environment variables.
spring.application.name=Mann-Ki-Aawaj
server.port=${SERVER_PORT:8080}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=${DATABASE_URL:jdbc:mysql://localhost:3306/mann_ki_aawaj?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata}
spring.datasource.username=${DATABASE_USERNAME:root}
spring.datasource.password=${DATABASE_PASSWORD:}
spring.jpa.hibernate.ddl-auto=update
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=${JPA_FORMAT_SQL:false}
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
music.storage.root=${MUSIC_STORAGE_ROOT:music-storage}
music.storage.audio-dir=audio
music.storage.cover-dir=covers
music.upload.max-audio-size=${MUSIC_MAX_AUDIO_SIZE:40MB}
music.upload.max-cover-size=${MUSIC_MAX_COVER_SIZE:5MB}
music.upload.user-max-pending=${MUSIC_USER_MAX_PENDING:5}
spring.servlet.multipart.max-file-size=${MULTIPART_MAX_FILE_SIZE:40MB}
spring.servlet.multipart.max-request-size=${MULTIPART_MAX_REQUEST_SIZE:46MB}
server.tomcat.max-swallow-size=${TOMCAT_MAX_SWALLOW_SIZE:48MB}
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION_MS:86400000}
spring.mail.host=${MAIL_HOST:smtp.hostinger.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
ai.moderation.enabled=${AI_MODERATION_ENABLED:true}
ai.translation.enabled=${AI_TRANSLATION_ENABLED:true}
openai.api-url=${OPENAI_API_URL:https://api.openai.com/v1}
openai.translation-model=${OPENAI_TRANSLATION_MODEL:gpt-4o-mini}
openai.translation.model=${OPENAI_TRANSLATION_MODEL:gpt-4o-mini}
openai.transcription-model=${OPENAI_TRANSCRIPTION_MODEL:gpt-4o-mini-transcribe}
openai.transcription.model=${OPENAI_TRANSCRIPTION_MODEL:gpt-4o-mini-transcribe}
openai.moderation-model=${OPENAI_MODERATION_MODEL:omni-moderation-latest}
openai.moderation.model=${OPENAI_MODERATION_MODEL:omni-moderation-latest}
openai.connect-timeout=${OPENAI_CONNECT_TIMEOUT:5s}
openai.read-timeout=${OPENAI_READ_TIMEOUT:30s}
socket.io.host=${SOCKET_IO_HOST:0.0.0.0}
socket.io.port=${SOCKET_IO_PORT:8085}
socket.io.allowed-origin=${SOCKET_IO_ALLOWED_ORIGIN:http://localhost:5173}
